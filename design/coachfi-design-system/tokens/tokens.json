  "font": {
    "family": {
      "sans": "'Nunito', 'Segoe UI', system-ui, sans-serif",
      "pixel": "'Pixelify Sans', 'Nunito', system-ui, sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Pixelify+Sans:wght@500;700&display=swap",
    "scale": {
      "display-xl": {
        "size": "3.5rem",
        "line": "3.75rem",
        "weight": 900,
        "tracking": "-0.03em"
      },
      "display-l": {
        "size": "2.5rem",
        "line": "2.75rem",
        "weight": 800,
        "tracking": "-0.02em"
      },
      "title": {
        "size": "1.75rem",
        "line": "2.125rem",
        "weight": 800
      },
      "heading": {
        "size": "1.25rem",
        "line": "1.625rem",
        "weight": 800
      },
      "body-l": {
        "size": "1.125rem",
        "line": "1.75rem",
        "weight": 400
      },
      "body": {
        "size": "1rem",
        "line": "1.5rem",
        "weight": 400
      },
      "label": {
        "size": "0.875rem",
        "line": "1.25rem",
        "weight": 700
      },
      "caption": {
        "size": "0.875rem",
        "line": "1.25rem",
        "weight": 500
      }
    },
    "numbers": "tabular-nums",
    "minBodyPx": 16,
    "kidsMinBodyPx": 18
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "radius": {
    "input": "8px",
    "button": "14px",
    "card": "20px",
    "sheet": "28px",
    "pill": "999px",
    "kids": "6px"
  },
  "shadow": {
    "e0": "none",
    "e1": "0 1px 2px rgba(30,27,46,.06), 0 2px 8px rgba(30,27,46,.06)",
    "e2": "0 8px 24px rgba(30,27,46,.10)",
    "e3": "0 24px 64px rgba(30,27,46,.18)",
    "kids-block": "0 5px 0 #1D2A1F",
    "teen-glow": "0 0 18px rgba(255,113,206,.55)",
    "press": "0 3px 0 #1E1B2E"
  },
  "motion": {
    "micro": "120ms",
    "standard": "200ms",
    "emphasis": "320ms",
    "celebrate": "600ms",
    "easeEnter": "cubic-bezier(.2,0,0,1)",
    "easeExit": "cubic-bezier(.3,0,1,1)",
    "milaMouthFps": 7
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px",
    "contentMax": "1200px"
  },
  "target": {
    "min": "44px",
    "default": "52px",
    "kids": "60px"
  },
  "focusRing": "3px solid var(--cf-focus), offset 2px",
  "button": {
    "primary": {
      "bg": "var(--cf-primary)",
      "text": "var(--cf-on-primary)",
      "border": "2px solid var(--cf-primary-border)",
      "shadow": "var(--cf-shadow-press)",
      "radius": "14px",
      "minHeight": "52px",
      "pressed": "translateY(3px); box-shadow none"
    },
    "secondary": {
      "bg": "var(--cf-surface)",
      "text": "var(--cf-text)",
      "border": "2px solid var(--cf-primary-border)",
      "radius": "14px"
    },
    "link": {
      "color": "var(--cf-grape)",
      "underline": "on hover/focus"
    }
  }
}