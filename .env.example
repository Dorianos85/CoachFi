# Coach FI API configuration
# Copy this file to .env.local and paste real keys. Do not commit .env.local.

# Anthropic Claude Haiku for AI Coach Mila
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=256

# Optional OpenRouter fallback/provider for AI Coach Mila
# Set AI_PROVIDER=openrouter if you want OpenRouter to be tried before Anthropic.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MAX_TOKENS=256
AI_PROVIDER=

# ElevenLabs text-to-speech for Mila voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional locale-specific voice IDs for the PL / EN / JA demo
ELEVENLABS_PL_VOICE_ID=
ELEVENLABS_EN_VOICE_ID=
ELEVENLABS_JA_VOICE_ID=

# Optional ElevenLabs Conversational AI widget agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_7601krc9gaf2eaxr811qgk01epzc

# Supabase leaderboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADERBOARD_TABLE=leaderboard
# Migration job. Local values live in .env.local. Preview and production deploys read the same names from Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=

# Solana Devnet NFT minting
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MINT_KEYPAIR=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development accounts. `npm run db:init` creates this SQLite file.
# Leave blank to use data/coachfi.dev.sqlite. The file is gitignored. Production uses Supabase.
# Set COACHFI_ACCOUNT_STORE=supabase to use Supabase from `npm run dev` as well.
# That still needs NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
COACHFI_DEV_DB=
COACHFI_ACCOUNT_STORE=

# Coinbase CDP user wallets. The project id is public. The API key is server-only and verifies access tokens.
# Do not expose CDP_API_KEY_SECRET in client code or commit a real value.
# Portal: allow this app's origin, and create a Solana account on email login.
# That address is the NFT owner. SOLANA_MINT_KEYPAIR still signs and pays for the mint.
# https://docs.cdp.coinbase.com/wallets/quickstart/user-auth
NEXT_PUBLIC_CDP_PROJECT_ID=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional. 0 means Coach FI never opens sign-in on its own.
# Lessons: after this many lessons are finished, one more lesson step asks for sign-in.
# Agent: after this many milliseconds of conversation with Mila.
NEXT_PUBLIC_SIGN_IN_LESSONS_FINISHED=0
NEXT_PUBLIC_SIGN_IN_STEPS_IN_ANOTHER_LESSON=0
NEXT_PUBLIC_SIGN_IN_AGENT_CONVERSATION_MS=0

# Local development only. Public Devnet address used as the NFT owner when no CDP wallet is connected.
# The dev server sends the mint as soon as you click, with no simulated wait.
NEXT_PUBLIC_DEV_MINT_RECIPIENT=
