# Coach FI API configuration
# Copy this file to .env.local and paste real keys. Do not commit .env.local.

# Anthropic Claude Haiku for AI Coach Mila
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=256

# Optional OpenRouter fallback/provider for AI Coach Mila
# Set AI_PROVIDER=openrouter if you want OpenRouter to be tried before Anthropic.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MAX_TOKENS=256
AI_PROVIDER=

# ElevenLabs text-to-speech for Mila voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional locale-specific voice IDs for the PL / EN / JA demo
ELEVENLABS_PL_VOICE_ID=
ELEVENLABS_EN_VOICE_ID=
ELEVENLABS_JA_VOICE_ID=

# Optional ElevenLabs Conversational AI widget agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_7601krc9gaf2eaxr811qgk01epzc

# Supabase leaderboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADERBOARD_TABLE=leaderboard

# Solana Devnet NFT minting
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MINT_KEYPAIR=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development accounts. `npm run db:init` creates this SQLite file.
# Leave blank to use data/coachfi.dev.sqlite. The file is gitignored. Production uses Supabase.
COACHFI_DEV_DB=

# Privy. The app id is public. PRIVY_APP_SECRET is server-only and verifies account tokens.
# Do not expose PRIVY_APP_SECRET in client code or commit a real value.
# Dashboard: enable Solana embedded wallets, create a wallet on login, and allow email login.
# That address is the NFT owner. SOLANA_MINT_KEYPAIR still signs and pays for the mint.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Local development only. Public Devnet address used as the NFT owner when no Privy wallet is connected.
# The dev server sends the mint as soon as you click, with no simulated wait.
NEXT_PUBLIC_DEV_MINT_RECIPIENT=
